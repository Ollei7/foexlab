[Unit]
Description=foeXlab Update vom USB-Stick (%I)
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=oneshot
# Stick nur zum Kopieren einhängen: nichts ausführbar, keine Gerätedateien
ExecStartPre=/bin/mkdir -p /run/foexlab-usb/%i
ExecStartPre=/bin/mount -t vfat,exfat,ext4 -o rw,noexec,nosuid,nodev,sync /dev/%I /run/foexlab-usb/%i
ExecStart=/usr/bin/python3 /opt/foexlab/usb_update.py /run/foexlab-usb/%i
ExecStartPost=/bin/sync
ExecStopPost=-/bin/sync
ExecStopPost=-/bin/umount /run/foexlab-usb/%i
TimeoutStartSec=900
