# Startet das foeXlab-Update, wenn ein USB-Stick mit Dateisystem eingesteckt wird.
# Nur Partitionen an USB (nicht die SD-Karte des Pi), nur vfat/exfat (FAT32, exFAT).
# ext4 ist absichtlich ausgeschlossen: Bootet ein Pi von einer USB-SSD, ist deren
# Systempartition ebenfalls USB und meist ext4 – sie wird so nie eingehängt.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="vfat|exfat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="foexlab-usb-update@%k.service"
