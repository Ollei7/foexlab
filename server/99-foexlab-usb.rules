# Startet das foeXlab-Update, wenn ein USB-Stick mit Dateisystem eingesteckt wird.
# Nur Partitionen an USB (nicht die SD-Karte des Pi), nur vfat/exfat/ext4.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="vfat|exfat|ext4", TAG+="systemd", ENV{SYSTEMD_WANTS}+="foexlab-usb-update@%k.service"
